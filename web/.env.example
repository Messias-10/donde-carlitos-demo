# Variables del front. Ninguna es secreta (el repo es público).
# Número de WhatsApp de pedidos en formato wa.me (solo dígitos). Para pruebas, usar un número de prueba propio.
NEXT_PUBLIC_WHATSAPP_PEDIDOS=
# URL pública del sitio (metadatos, Open Graph, sitemap).
NEXT_PUBLIC_SITE_URL=
# URL interna de la API en Go (red de Docker). Por defecto http://api:8080.
API_INTERNAL_URL=
