# Variables de la API. No hace falta copiar este archivo: setup-admin crea api/.env.
# Aquí solo van los nombres. Los valores por defecto (no secretos) están en
# api/README.md; docker-compose.yml fija los del demo.

# --- Secretos / datos privados (van solo en api/.env; nunca a git) ---
ADMIN_USUARIO=
ADMIN_PASSWORD_HASH_B64=
SESSION_SECRET=
DATOS_TRANSFERENCIA=

# --- Configuración (no secreta) ---
APP_ENV=
LISTEN_ADDR=
DB_PATH=
IMAGENES_DIR=
ALLOWED_ORIGINS=
TRUSTED_PROXIES=
WHATSAPP_SANTIAGO=
WHATSAPP_REGIONES=
URL_SITIO=
DIRECCION_RETIRO=
HORARIO_RETIRO=
HORARIO_CONFIRMADO=
MODO_DEMO=
STOCK_ESTRICTO=
SEED_DEMO=
SEED_PEDIDOS_DEMO=
DIAS_RECIEN_LLEGADO=
LOGIN_GLOBAL_MIN=
SEGUIMIENTO_POR_IP_MIN=
LOG_LEVEL=
