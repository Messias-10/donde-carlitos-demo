# Variables de la API. No hace falta copiar este archivo: setup-admin crea api/.env.
# Aquí solo van los nombres. Los valores por defecto (no secretos) están en
# api/README.md; docker-compose.yml fija los del demo.

# --- Secretos (los escribe setup-admin; nunca a mano, nunca a git) ---
ADMIN_USUARIO=
ADMIN_PASSWORD_HASH_B64=
SESSION_SECRET=

# --- Configuración (no secreta) ---
APP_ENV=
LISTEN_ADDR=
DB_PATH=
IMAGENES_DIR=
ALLOWED_ORIGINS=
TRUSTED_PROXIES=
WHATSAPP_NUMERO=
TIENDA_DIRECCION=
PEDIDOS_DEMO=
SEED_DEMO=
SEED_PEDIDOS_DEMO=
DIAS_RECIEN_LLEGADO=
PEDIDOS_POR_IP=
PEDIDOS_VENTANA_MIN=
PEDIDOS_POR_TELEFONO=
PEDIDOS_GLOBAL_HORA=
PEDIDOS_ABIERTOS_POR_TELEFONO=
LOGIN_GLOBAL_MIN=
